# Firebase Web App configuration.
# Copy this file to `.env` and fill in the values from the Firebase Console
# (Project settings > Your apps > Web app > SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the app at local Firebase emulators instead of the cloud.
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_URL=http://127.0.0.1:8080
# VITE_FIREBASE_STORAGE_EMULATOR_URL=http://127.0.0.1:9199

# --- Evidence file storage (Supabase Storage Free) --------------------------
# Observation/action evidence binaries are uploaded from the browser to a
# PUBLIC `evidence` bucket. Uploads are authorized by the user's Firebase ID
# token via Supabase Third-Party Auth (register the Firebase project's JWKS
# in Supabase so these tokens are recognized as `authenticated`).
# Only browser-safe values belong here — NEVER the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Super Admin bootstrap (NOT a Vite variable) ---------------------------
# The bootstrap script (npm run bootstrap:admin) is run locally with the
# Firebase Admin SDK. It requires a service-account JSON file, never a Vite
# variable. Use either an explicit --service-account path or this variable:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json